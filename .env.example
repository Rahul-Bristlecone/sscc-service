# SSCC Service Environment Configuration
# Copy this file to .env and update values for your environment

# Flask Configuration
SECRET_KEY=dev-secret-change-in-production
FLASK_ENV=development

# Database Configuration
# For production: mysql+pymysql://user:password@host:3306/sscc_db
# For local: sqlite:///sscc.db
SQLALCHEMY_DATABASE_URI=sqlite:///:memory:
SQLALCHEMY_TRACK_MODIFICATIONS=false

# MySQL Configuration (for containerized deployment)
MYSQL_ROOT_PASSWORD=supersecret
MYSQL_USER=sscc_user
MYSQL_PASSWORD=sscc_password
MYSQL_DATABASE=sscc_db
DB_HOST=sscc-db
DB_PORT=3306

# GS1 Configuration
GS1_COMPANY_PREFIX=1234567
SSCC_EXTENSION_DIGIT=0

# Order Service Integration
ORDER_SERVICE_URL=http://order-service:5007
SERVICE_REQUEST_TIMEOUT=5

# AWS Lambda Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 Configuration for PDF Storage
S3_BUCKET=sscc-pdf-bucket
S3_PREFIX=sscc-labels/

# Redis Configuration (optional, for caching/queuing)
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS Configuration - Critical for frontend access
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:3000,http://localhost:5000

# JWT Configuration (for future API authentication)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
